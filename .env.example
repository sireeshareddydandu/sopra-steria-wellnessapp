# Copy to .env only if you want to set values manually. Keep .env private.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-a-long-random-secret
DATA_DIR=./data
COOKIE_SECURE=0
# If DEPARTMENT_ADMINS is omitted on first run, the app generates six unique
# department accounts and passwords into the private .env file automatically.
# You can instead provide a one-line JSON object matching saved category labels.
